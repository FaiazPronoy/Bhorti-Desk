<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SchoolAdmission.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <!-- MIT licence. Turns the slip's verify address into QR modules; nothing else. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- MIT licence. Writes the API description at /openapi/v1.json. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- The schema ships inside the dll, so there is no file path to get wrong in a container. -->
    <EmbeddedResource Include="Data\Schema\admission_schema.sql" LogicalName="admission_schema.sql" />
  </ItemGroup>

</Project>
