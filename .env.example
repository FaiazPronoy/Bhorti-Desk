# Every value here has a default in docker-compose.yml, so this file is optional.
# Copy it to .env only if you want to change something.

# PostgreSQL inside the compose network. Local demo values only.
POSTGRES_DB=school_admission
POSTGRES_USER=school_admission
POSTGRES_PASSWORD=local_dev_only_password

# How long a seat hold lasts, in seconds.
HOLD_DURATION_SECONDS=600

# Which browser origins may call the API. Comma separated, or *.
CORS_ALLOWED_ORIGINS=*

# The API address the browser uses.
API_BASE_URL=http://localhost:8080

# Host port for the website.
FRONTEND_PORT=3000
