# Every value here has a default in docker-compose.yml, so this file is optional.
# Copy it to .env only if you want to change something.

# PostgreSQL inside the compose network. Local demo values only.
POSTGRES_DB=school_admission
POSTGRES_USER=school_admission
POSTGRES_PASSWORD=local_dev_only_password

# How long a seat hold lasts, in seconds.
HOLD_DURATION_SECONDS=600

# Which browser origins may call the API. Comma separated, or *.
CORS_ALLOWED_ORIGINS=*

# The API address the browser uses.
API_BASE_URL=http://localhost:8080

# Host port for the website.
FRONTEND_PORT=3000

# First school office account, created when there is none yet. Use a long password.
ADMIN_EMAIL=admin@bhortidesk.local
ADMIN_PASSWORD=change-this-local-password

# Local demo only: sign-in codes are printed to the backend log. Set false in production.
OTP_LOG_CODES=true

# Keep false for http://localhost. Set true behind HTTPS.
COOKIE_SECURE=false

# Anti-abuse. A family can hold this many unpaid seats at once.
MAX_ACTIVE_HOLDS_PER_GUARDIAN=3
# After a hold runs out unpaid, the same student waits this long before re-applying to that class.
HOLD_COOLDOWN_SECONDS=600
# Rate limits on sign-in and applying. Keep true in production.
RATE_LIMITS_ENABLED=true
